# Copy this file to ".env" (same folder) and paste your real values after each =
# Never commit .env. Online, these go in GitHub > Settings > Secrets and variables > Actions.
GROQ_API_KEY=paste_your_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_paste_your_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_your_key_here
# Only needed to refresh the background videos (python fetch_videos.py). Free: pixabay.com/api/docs
PIXABAY_API_KEY=paste_your_key_here
